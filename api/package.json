{
  "name": "codecohesion-api",
  "version": "0.7.0",
  "description": "REST API for CodeCohesion repository analysis data",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint ."
  },
  "keywords": [
    "codecohesion",
    "api",
    "repository-analysis"
  ],
  "author": "Paul Rayner",
  "license": "MIT",
  "dependencies": {
    "@codecohesion/shared-types": "*",
    "codecohesion-processor": "*",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.4",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/ui": "^4.0.4",
    "eslint": "^10.0.3",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
