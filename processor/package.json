{
  "name": "codecohesion-processor",
  "version": "0.5.0",
  "description": "Repository analyzer for code cohesion and evolution visualization",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/analyze.js",
    "dev": "ts-node src/cli.ts",
    "prototype-timeline": "ts-node src/prototype-timeline-sampler.ts",
    "analyze:full-delta": "ts-node src/cli.ts",
    "coupling": "ts-node src/coupling-cli.ts",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "keywords": [
    "git",
    "cohesion",
    "temporal-coupling",
    "code-analysis",
    "ddd",
    "visualization"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@codecohesion/shared-types": "*",
    "graphology": "^0.25.4",
    "graphology-communities-louvain": "^2.0.2",
    "simple-git": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "vitest": "^4.0.4"
  }
}
